rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function staff() {
   return request.auth != null
    && request.auth.token.role in ['admin', 'cashier']
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == request.auth.token.role;
  }
  function admin() { return staff() && request.auth.token.role == 'admin'; }
  function owner() { return staff() && resource.data.cashierId == request.auth.uid; }
  match /users/{uid} { allow read: if admin() || (staff() && request.auth.uid == uid); }
  match /products/{id} { allow read: if staff(); }
  match /categories/{id} { allow read: if staff(); }
  match /suppliers/{id} { allow read: if admin(); }
  match /registers/{id} { allow read: if staff(); }
  match /sales/{id} { allow read: if admin() || owner(); }
  match /shifts/{id} { allow read: if admin() || owner(); }
  match /cashMovements/{id} { allow read: if admin() || owner(); }
  match /inventoryMovements/{id} { allow read: if admin(); }
  match /logs/{id} { allow read: if admin(); }
  match /settings/store { allow read: if staff(); }
  match /{document=**} { allow read, write: if false; }
 }
}
